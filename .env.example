# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL Neon)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters

# CORS (Frontend domain in Vercel and local dev)
CORS_ORIGIN=http://localhost:5173

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=our-memories

# Quota & Upload limits (Bytes)
# 9 GB default quota
QUOTA_BYTES=9663676416
# 5 GB default single file limit
MAX_FILE_BYTES=5368709120

# Seed Passwords (for initial 2 users)
SEED_PASSWORD_1=change_me_user1
SEED_PASSWORD_2=change_me_user2
